{
  "name": "powerstudio",
  "version": "0.1.0",
  "private": true,
  "description": "Power system analysis in the browser: load flow, IEC 60909-style short circuit, N-1 contingency and RMS stability on a single-line diagram.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "check": "tsc -p tsconfig.json && tsc -p tsconfig.worker.json",
    "build": "node build.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@webgpu/types": "0.1.74",
    "typescript": "7.0.2"
  }
}
